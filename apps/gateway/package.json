{
  "name": "@agentify/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/run.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentify/adapter-mock": "workspace:*",
    "@agentify/canonical-commerce": "workspace:*",
    "@agentify/mcp": "workspace:*",
    "@agentify/metadata": "workspace:*",
    "@agentify/payments": "workspace:*",
    "@agentify/ucp": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.13.5",
    "@agentify/payments-razorpay": "workspace:*",
    "@agentify/audit": "workspace:*",
    "@agentify/adapter-rest": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
