# ============================================================================
# Agentify — environment variables
# Copy to `.env` (git-ignored) and fill in values. This file documents the
# format; nothing here is a real secret.
# ============================================================================

# ---------------------------------------------------------------------------
# Gateway server (apps/gateway, `pnpm gateway`)
# ---------------------------------------------------------------------------

# HTTP port the gateway listens on.
PORT=8787

# Public origin under which the gateway is reachable. Used to build the UCP
# profile, MCP/agents.md/llms.txt URLs. Use your real public URL in production;
# http://localhost:8787 is fine for local runs.
BASE_URL=http://localhost:8787

# Storefront origin used to build product/source URLs. Defaults to BASE_URL
# when unset.
# STORE_URL=https://www.my-store.example

# ---------------------------------------------------------------------------
# Razorpay (test mode by default). When KEY_ID + KEY_SECRET are set, payments
# are enabled automatically on `pnpm gateway` / `agentify serve --payment razorpay`.
# ---------------------------------------------------------------------------

# Test API keys from the Razorpay dashboard: Settings -> API Keys (test mode).
# Test keys start with rzp_test_ ; live keys with rzp_live_ .
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret for HMAC-SHA256 signature validation on /webhooks/razorpay.
# Create it in the dashboard: Settings -> Webhooks. Required for webhook
# reconciliation; polling reconciliation (demo) works without it.
RAZORPAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# Payment mode: test (default) or live. Live mode is blocked unless the code
# explicitly opts in (allowLive) — keep this as "test" for sandbox runs.
RAZORPAY_MODE=test

# ---------------------------------------------------------------------------
# Audit trail (explainable, bounded, gated money actions)
# ---------------------------------------------------------------------------

# Optional SQLite file for persisting audit events across restarts.
# When unset, the gateway keeps an in-memory audit trail for the session.
# AGENTIFY_AUDIT_PATH=./data/audit.db

# ---------------------------------------------------------------------------
# Local dashboard (apps/dashboard) — separate process from the gateway
# ---------------------------------------------------------------------------

# Port for the dashboard API + built UI (default 8788).
# DASHBOARD_PORT=8788

# Where merchant config files are stored (default ./data/merchants).
# DATA_DIR=./data/merchants

# ---------------------------------------------------------------------------
# Demos (scripts/)
# ---------------------------------------------------------------------------

# Point a demo at an already-running gateway instead of booting its own.
# Used by scripts/agent-demo.ts. Leave unset to auto-boot a local gateway.
# GATEWAY_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# Optional debug
# ---------------------------------------------------------------------------

# Print bridge errors when mounting the gateway on Express/Fastify/raw Node
# (@agentify/middleware).
# DEBUG_GATEWAY_BRIDGE=1

# ---------------------------------------------------------------------------
# Real-network integration test (opt-in, skipped when unset)
# Used by tests/integration/razorpay-real.test.ts. Prefix differs so CI can
# enable it deliberately without loading dashboard keys into the server env.
# ---------------------------------------------------------------------------

# RAZORPAY_TEST_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
# RAZORPAY_TEST_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_TEST_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX
