    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "target": "ES2022"
  },
  "include": ["src"],
  "exclude": ["dist", "test", "tests"]
}
