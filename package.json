{
  "name": "agentcart",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Commerce Gateway monorepo - turn any ecommerce backend into an agent-native merchant",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck",
    "gateway": "tsx apps/gateway/src/run.ts",
    "demo": "tsx scripts/agent-demo.ts",
    "demo:second": "tsx scripts/second-store-demo.ts",
    "demo:razorpay": "tsx scripts/razorpay-demo.ts",
    "demo:razorpay:real": "tsx scripts/razorpay-demo-real.ts",
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/postbuild-docs.mjs",
    "dashboard": "tsx apps/dashboard/src/api/index.ts",
    "dashboard:web": "pnpm exec vite --config apps/dashboard/ui/vite.config.ts",
    "dashboard:build": "pnpm exec vite build --config apps/dashboard/ui/vite.config.ts"
  },
  "devDependencies": {
    "@agentify/adapter-mock": "workspace:*",
    "@agentify/adapter-rest": "workspace:*",
    "@agentify/canonical-commerce": "workspace:*",
    "@agentify/gateway": "workspace:*",
    "@agentify/mcp": "workspace:*",
    "@agentify/metadata": "workspace:*",
    "@agentify/payments": "workspace:*",
    "@agentify/payments-razorpay": "workspace:*",
    "@agentify/ucp": "workspace:*",
    "@changesets/cli": "^2.27.0",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0",
    "@agentify/audit": "workspace:*"
  }
}
